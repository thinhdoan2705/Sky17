<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Sky17_Web-50c87a9d-b27b-4166-9f50-65125bf0e195</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sky17.Infrastructure\Sky17.Infrastructure.csproj" />
    <ProjectReference Include="..\Sky17.Application\Sky17.Application.csproj" />
    <ProjectReference Include="..\Sky17.Domain\Sky17.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
