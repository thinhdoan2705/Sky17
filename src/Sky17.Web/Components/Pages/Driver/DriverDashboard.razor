@page "/driver"
@inherits PortalPage
@inject IDriverService Drivers

<PageTitle>Tài xế | Sky 17</PageTitle>

@if (Loading || d is null || profile is null) { <Skeleton Cards="3" Lines="4" /> }
else
{
    <div class="page-head">
        <div>
            <h1>Xin chào, @profile.FullName! 🛵</h1>
            <p class="muted" style="margin:0">Bật nhận chuyến, hệ thống sẽ gửi đơn gần bạn nhất.</p>
        </div>
        <StatusBadge Text="@($"● {profile.Status.Text()}")" Variant="@profile.Status.Css()" />
    </div>

    @if (profile.Status == DriverStatus.PendingApproval)
    {
        <div class="alert alert-warning">⏳ Hồ sơ của bạn đang chờ quản trị viên duyệt. Bạn sẽ nhận được thông báo khi có thể bắt đầu nhận chuyến.</div>
    }
    else if (profile.Status is DriverStatus.Suspended or DriverStatus.Rejected)
    {
        <div class="alert alert-danger">Tài khoản tài xế @profile.Status.Text().ToLower(): @profile.StatusReason</div>
    }

    <div class="driver-summary">
        <div class="section-title">
            <h2 style="color:white;margin:0">Tổng quan hôm nay</h2>
            <span style="background:#ffffff22;border-radius:20px;padding:6px 11px;font-size:11px">@Fmt.Date(DateTime.UtcNow)</span>
        </div>
        <div class="numbers">
            <div><span style="color:#d7e7ff;font-size:11px">Thu nhập hôm nay</span><strong>@Fmt.Vnd(d.EarningToday)</strong></div>
            <div><span style="color:#d7e7ff;font-size:11px">Chuyến hoàn thành</span><strong>@d.CompletedToday</strong></div>
            <div><span style="color:#d7e7ff;font-size:11px">Tỷ lệ nhận (7 ngày)</span><strong>@(stats?.AcceptanceRatePercent ?? 100)%</strong></div>
        </div>
    </div>

    <div class="driver-grid">
        <div class="stack">
            @if (active.Count > 0)
            {
                @foreach (var j in active)
                {
                    <section class="card">
                        <div class="section-title"><h2>Chuyến hiện tại</h2><OrderStatusBadge Status="j.Status" /></div>
                        <DeliveryCard Job="j"><DriverJobActions Job="j" ShowDetailLink="true" OnChanged="ReloadAsync" /></DeliveryCard>
                    </section>
                }
            }
            else if (d.IsOnline && profile.Status == DriverStatus.Active)
            {
                <section class="card text-center">
                    <div class="radar">🛵</div>
                    <h2>Đang tìm chuyến gần bạn...</h2>
                    <p class="muted">Giữ ứng dụng mở để nhận chuyến. Khi có đơn, điện thoại sẽ đổ chuông và bạn có @offerSeconds giây để nhận.</p>
                    @if (d.AvailableJobs > 0) { <span class="tag">@d.AvailableJobs đơn đang tìm tài xế trong hệ thống</span> }
                </section>
            }
            else
            {
                <section class="card text-center">
                    <div style="font-size:46px">😴</div>
                    <h2>Bạn đang offline</h2>
                    <p class="muted">Bật công tắc ở góc trên để bắt đầu nhận chuyến.</p>
                </section>
            }
        </div>
        <aside class="stack">
            <div class="card">
                <div class="section-title"><h2>Bản đồ</h2><span class="muted small">@profile.ServiceArea</span></div>
                <MapView Markers="MapMarkers.ForDriver(active, profile)" ShowMyLocation="true" Height="300px" EmptyText="Bật nhận chuyến để hiển thị vị trí của bạn." />
            </div>
            <div class="card">
                <h2>💰 Ví COD</h2>
                <div class="row-item"><span class="grow muted">Tiền mặt đang giữ</span><strong>@Fmt.Vnd(d.CodHolding)</strong></div>
                <div class="row-item"><span class="grow muted">Cần nộp về Sky 17</span><strong class="danger-text">@Fmt.Vnd(d.OwedToPlatform)</strong></div>
                <a class="btn btn-soft btn-block mt-1" href="/driver/earnings">Thu nhập & đối soát</a>
            </div>
            @if (stats is { Offered: > 0 })
            {
                <div class="card">
                    <h2>Lời mời 7 ngày</h2>
                    <div class="row-item"><span class="grow muted">Đã nhận</span><b class="success-text">@stats.Accepted</b></div>
                    <div class="row-item"><span class="grow muted">Bỏ qua</span><b>@stats.Declined</b></div>
                    <div class="row-item"><span class="grow muted">Hết giờ</span><b class="danger-text">@stats.Expired</b></div>
                </div>
            }
        </aside>
    </div>
}

@code {
    private DriverDashboardDto? d;
    private DriverProfileDto? profile;
    private DriverOfferStatsDto? stats;
    private IReadOnlyList<DeliveryJobDto> active = [];
    private int offerSeconds = 30;

    protected override async Task LoadAsync()
    {
        profile = await Drivers.GetProfileAsync();
        d = await Drivers.GetDashboardAsync();
        active = await Drivers.GetMyActiveJobsAsync();
        stats = await Drivers.GetOfferStatsAsync();
    }
}
