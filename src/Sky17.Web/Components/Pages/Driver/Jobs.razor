@page "/driver/jobs"
@inherits PortalPage
@inject IDriverService Drivers

<PageHeader Title="Đơn đang mở 📦" Subtitle="Các đơn đã sẵn sàng tại cửa hàng, chờ tài xế nhận" />

@if (Loading || d is null) { <Skeleton Lines="6" /> }
else
{
    @if (d.Status != DriverStatus.Active)
    {
        <div class="alert alert-warning">Hồ sơ tài xế cần được duyệt trước khi xem và nhận đơn.</div>
    }
    else if (!d.IsOnline)
    {
        <div class="offline-banner">Bạn đang offline. Bật công tắc nhận đơn ở góc trên để nhận chuyến.</div>
    }
    else if (d.ActiveCount >= d.MaxActive)
    {
        <div class="alert alert-info">Bạn đang có @d.ActiveCount đơn (tối đa @d.MaxActive). Hoàn thành đơn hiện tại để nhận thêm.</div>
    }
    <div class="card">
        @if (jobs.Count == 0) { <EmptyState Icon="📭" Title="Chưa có đơn sẵn sàng" Text="Danh sách tự cập nhật khi cửa hàng báo sẵn sàng." /> }
        @foreach (var j in jobs)
        {
            <DeliveryCard Job="j"><DriverJobActions Job="j" CanAccept="CanAccept" OnChanged="ReloadAsync" /></DeliveryCard>
        }
    </div>
}

@code {
    private DriverDashboardDto? d;
    private IReadOnlyList<DeliveryJobDto> jobs = [];
    private bool CanAccept => d is { IsOnline: true, Status: DriverStatus.Active } && d.ActiveCount < d.MaxActive;

    protected override async Task LoadAsync()
    {
        d = await Drivers.GetDashboardAsync();
        jobs = await Drivers.GetAvailableJobsAsync();
    }
}
