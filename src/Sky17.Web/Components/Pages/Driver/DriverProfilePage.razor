@page "/driver/profile"
@inherits PortalPage
@inject IDriverService Drivers
@inject IProfileService Profiles

<PageHeader Title="Hồ sơ tài xế" Subtitle="Thông tin cá nhân và phương tiện" />

@if (Loading || p is null) { <Skeleton Lines="6" /> }
else
{
    <div class="grid-half">
        <section class="card">
            <div class="section-title"><h2>Thông tin cá nhân</h2><StatusBadge Text="@p.Status.Text()" Variant="@p.Status.Css()" /></div>
            <EditForm Model="person" OnValidSubmit="SavePerson">
                <DataAnnotationsValidator />
                <div class="field"><label>Email</label><input value="@p.Email" disabled /></div>
                <div class="field"><label>Họ và tên</label><InputText @bind-Value="person.FullName" /><ValidationMessage For="() => person.FullName" /></div>
                <div class="field"><label>Số điện thoại</label><InputText type="tel" @bind-Value="person.PhoneNumber" /><ValidationMessage For="() => person.PhoneNumber" /></div>
                <button class="btn" type="submit" disabled="@Busy">Lưu</button>
            </EditForm>
        </section>
        <section class="card">
            <h2>Phương tiện</h2>
            <EditForm Model="vehicle" OnValidSubmit="SaveVehicle">
                <DataAnnotationsValidator />
                <div class="fields">
                    <div class="field"><label>Loại xe</label><InputText @bind-Value="vehicle.VehicleType" /><ValidationMessage For="() => vehicle.VehicleType" /></div>
                    <div class="field"><label>Biển số</label><InputText @bind-Value="vehicle.LicensePlate" /><ValidationMessage For="() => vehicle.LicensePlate" /></div>
                    <div class="field"><label>Số CCCD</label><InputText @bind-Value="vehicle.IdentityNumber" /></div>
                    <div class="field"><label>Khu vực hoạt động</label><InputText @bind-Value="vehicle.ServiceArea" /></div>
                </div>
                <button class="btn" type="submit" disabled="@Busy">Lưu phương tiện</button>
            </EditForm>
            <div class="mt-2">
                <a class="row-item" href="/notifications"><span class="grow">🔔 Thông báo</span>›</a>
                <a class="row-item" href="/Account/Manage/ChangePassword" data-enhance-nav="false"><span class="grow">🔑 Đổi mật khẩu</span>›</a>
                <form action="/Account/Logout" method="post" data-enhance="false" class="mt-1">
                    <AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" />
                    <button type="submit" class="btn btn-outline btn-block danger-text">Đăng xuất</button>
                </form>
            </div>
        </section>
    </div>
    <section class="card mt-2" id="vi-tri">
        <div class="section-title">
            <h2>📍 Vị trí nhận chuyến</h2>
            <span class="small muted">Cập nhật lần cuối: @(p.LastLocationAtUtc is { } at ? Fmt.Ago(at) : "chưa có")</span>
        </div>
        <p class="small muted">Hệ thống gửi chuyến cho tài xế rảnh <b>gần quán nhất</b> dựa trên vị trí này. Khi đang bật nhận chuyến, ứng dụng tự gửi vị trí mỗi 20 giây.</p>
        <div class="tabs">
            <button class="@(mode == "gps" ? "active" : "")" @onclick="@(() => SetModeAsync("gps"))">🛰️ Dùng GPS điện thoại (khuyên dùng)</button>
            <button class="@(mode == "manual" ? "active" : "")" @onclick="@(() => SetModeAsync("manual"))">📌 Ghim vị trí thủ công</button>
        </div>
        @if (mode == "manual")
        {
            <LocationPicker Label="Vị trí chờ chuyến của bạn" Latitude="manualLat" Longitude="manualLng" OnChanged="PickManual" Height="280px" />
            <div class="form-actions"><button class="btn" disabled="@(Busy || manualLat is null)" @onclick="SaveManual">Lưu vị trí</button></div>
        }
        else
        {
            <p class="small">GPS chỉ hoạt động qua HTTPS (hoặc localhost) và khi bạn cho phép trình duyệt truy cập vị trí. Nếu không lấy được GPS, hãy chuyển sang ghim thủ công.</p>
        }
    </section>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private DriverProfileDto? p;
    private ProfileInput person = new();
    private DriverProfileInput vehicle = new();
    private string mode = "gps";
    private double? manualLat, manualLng;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/driver.js");
            mode = await module.InvokeAsync<string>("getMode");
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task SetModeAsync(string m)
    {
        mode = m;
        if (module is not null) await module.InvokeVoidAsync("setMode", m);
        if (m == "gps") await Realtime.RaiseAsync(null); // layout restarts tracking with GPS
    }

    private void PickManual((double? Lat, double? Lng) pt) { manualLat = pt.Lat; manualLng = pt.Lng; }

    private Task SaveManual() => RunAsync(async () =>
    {
        await Drivers.UpdateLocationAsync(manualLat!.Value, manualLng!.Value);
        if (module is not null) await module.InvokeVoidAsync("setMode", "manual");
        await Realtime.RaiseAsync(null); // layout restarts heartbeats with the pinned point
    }, "Đã lưu vị trí chờ chuyến");

    protected override async Task LoadAsync()
    {
        p = await Drivers.GetProfileAsync();
        person = new ProfileInput { FullName = p.FullName, PhoneNumber = p.PhoneNumber };
        vehicle = new DriverProfileInput { VehicleType = p.VehicleType, LicensePlate = p.LicensePlate, IdentityNumber = p.IdentityNumber, ServiceArea = p.ServiceArea };
        manualLat ??= p.LastLatitude;
        manualLng ??= p.LastLongitude;
    }

    protected override bool ReloadOnRealtime(RealtimeMessage? m) => false;

    private Task SavePerson() => RunAsync(() => Profiles.UpdateMineAsync(person), "Đã lưu thông tin");
    private Task SaveVehicle() => RunAsync(() => Drivers.UpdateProfileAsync(vehicle), "Đã lưu phương tiện");
}
