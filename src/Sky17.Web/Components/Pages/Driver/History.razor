@page "/driver/history"
@inherits PortalPage
@inject IDriverService Drivers

<PageHeader Title="Lịch sử chuyến" Subtitle="Các chuyến giao đã hoàn tất, thất bại hoặc đã hủy" />

@if (Loading) { <Skeleton Lines="6" /> }
else if (page is null || page.TotalCount == 0) { <div class="card"><EmptyState Icon="▤" Title="Chưa có chuyến nào" /></div> }
else
{
    <div class="card">
        @foreach (var j in page.Items)
        {
            <a class="row-item" href="@(j.IsMine ? $"/driver/deliveries/{j.OrderId}" : null)">
                <div class="avatar">@(j.Status == OrderStatus.Delivered ? "✅" : j.Status == OrderStatus.Cancelled ? "✕" : "⚠️")</div>
                <div class="grow">
                    <strong>@j.Code · @j.StoreName</strong>
                    <span class="small muted">@Fmt.Time(j.CompletedAtUtc ?? j.PlacedAtUtc) · @j.DropoffAddress</span>
                </div>
                <div class="text-right">
                    <OrderStatusBadge Status="j.Status" />
                    @if (j.IsMine && j.Status == OrderStatus.Delivered) { <div class="success-text strong mt-1">+@Fmt.Vnd(j.DriverEarning)</div> }
                </div>
            </a>
        }
        <Pagination Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPage="Go" />
    </div>
}

@code {
    private PagedResult<DeliveryJobDto>? page;
    private int pageNo = 1;

    protected override async Task LoadAsync() => page = await Drivers.GetHistoryAsync(pageNo);
    private async Task Go(int p) { pageNo = p; await ReloadAsync(); }
}
