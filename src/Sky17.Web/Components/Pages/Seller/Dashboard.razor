@page "/seller"

<PageHeader Title="@($"Xin chào, {Ctx.Current?.Name ?? "cửa hàng"} {Ctx.Current?.Emoji}")" Subtitle="Tình hình kinh doanh hôm nay">
    <Actions><a class="btn" href="/seller/products/new">+ Thêm sản phẩm</a></Actions>
</PageHeader>

<StoreGate>
    @if (Loading || d is null) { <Skeleton Cards="4" Lines="4" /> }
    else
    {
        <div class="kpis">
            <KpiCard Icon="▣" Label="Đơn hôm nay" Value="@d.OrdersToday.ToString()" Note="@($"{d.InProgressCount} đơn đang xử lý")" />
            <KpiCard Icon="◉" Variant="green" Label="Doanh thu hôm nay" Value="@Fmt.Vnd(d.RevenueToday)" Note="Giá trị món (trừ đơn hủy)" />
            <KpiCard Icon="⏳" Variant="orange" Label="Đơn cần xác nhận" Value="@d.PendingCount.ToString()" Note="@(d.PendingCount > 0 ? "Cần xử lý ngay" : "Không có đơn chờ")" Muted="d.PendingCount == 0" />
            <KpiCard Icon="▦" Variant="purple" Label="Sản phẩm đang bán" Value="@d.ActiveProducts.ToString()" Note="@($"{d.LowStockProducts} sản phẩm sắp hết")" />
        </div>
        <div class="grid-2">
            <section class="card">
                <div class="section-title"><h2>Đơn cần xử lý</h2><a href="/seller/orders" class="link">Xem tất cả →</a></div>
                @if (d.ActionOrders.Count == 0) { <EmptyState Icon="✅" Title="Không có đơn cần xử lý" /> }
                @foreach (var o in d.ActionOrders)
                {
                    <div class="row-item">
                        <div class="avatar">📦</div>
                        <div class="grow">
                            <strong><a href="/seller/orders/@o.Id">@o.Code</a> · @o.CustomerName</strong>
                            <p class="small muted">@Fmt.Vnd(o.GrandTotal) · @o.ItemCount món · @Fmt.Ago(o.PlacedAtUtc)</p>
                        </div>
                        <OrderStatusBadge Status="o.Status" />
                        @if (Next(o.Status) is { } next)
                        {
                            <button class="btn btn-soft btn-sm" disabled="@Busy" @onclick="() => Advance(o.Id, next)">@next.ActionText()</button>
                        }
                    </div>
                }
            </section>
            <section class="card">
                <h2>Hiệu suất cửa hàng</h2>
                <div class="row-item"><div class="grow">Tỷ lệ đơn không bị hủy (30 ngày)</div><strong>@d.ConfirmRatePercent%</strong></div>
                <div class="progress"><span style="width:@d.ConfirmRatePercent%"></span></div>
                <div class="row-item"><div class="grow">Đơn đang chuẩn bị / chờ giao</div><strong>@d.InProgressCount</strong></div>
                <div class="row-item"><div class="grow">Sản phẩm tồn kho ≤ 5</div><strong class="@(d.LowStockProducts > 0 ? "danger-text" : "")">@d.LowStockProducts</strong></div>
                <p class="stat-note">Số liệu tính trực tiếp từ đơn hàng trong hệ thống.</p>
            </section>
        </div>
        <section class="card mb-2">
            <div class="section-title"><h2>Doanh thu 7 ngày</h2><span class="tag">Giá trị món</span></div>
            <BarChart Points="d.Last7Days" ShowAmount="true" AriaLabel="Doanh thu 7 ngày" />
        </section>
        <section class="card">
            <div class="section-title"><h2>Sản phẩm bán chạy</h2><a class="link" href="/seller/products">Quản lý →</a></div>
            @if (d.TopProducts.Count == 0) { <EmptyState Icon="▦" Title="Chưa có sản phẩm"><a class="btn" href="/seller/products/new">+ Thêm sản phẩm</a></EmptyState> }
            <div class="product-list">
                @foreach (var p in d.TopProducts)
                {
                    <div class="card product">
                        <div class="product-photo">@if (p.ImageUrl is not null) { <img src="@p.ImageUrl" alt="" /> } else { @p.Emoji }</div>
                        <strong>@p.Name</strong>
                        <span class="muted small">@p.CategoryName · Kho: @p.Stock · Đã bán: @p.SoldQuantity</span>
                        <div class="product-foot"><span class="product-price">@Fmt.Vnd(p.Price)</span><a class="icon-btn" href="/seller/products/@p.Id" aria-label="Sửa">✏️</a></div>
                    </div>
                }
            </div>
        </section>
    }
</StoreGate>

@code {
    private SellerDashboardDto? d;

    protected override async Task LoadStoreAsync() => d = await Seller.GetDashboardAsync(StoreId);

    private static OrderStatus? Next(OrderStatus s) => s switch
    {
        OrderStatus.Pending => OrderStatus.Confirmed,
        OrderStatus.Confirmed => OrderStatus.Preparing,
        OrderStatus.Preparing => OrderStatus.ReadyForPickup,
        _ => null,
    };

    private Task Advance(int orderId, OrderStatus target) =>
        RunAsync(() => Seller.ChangeOrderStatusAsync(StoreId, orderId, target, null), $"Đã cập nhật: {target.Text()}");
}
