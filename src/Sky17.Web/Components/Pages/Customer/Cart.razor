@page "/cart"
@attribute [Authorize(Roles = Roles.Customer)]
@inherits PortalPage
@inject ICartService CartService
@inject CartState CartBadge

<PageHeader Title="Giỏ hàng của bạn" Subtitle="@(carts.Count > 1 ? $"{carts.Count} giỏ hàng · mỗi cửa hàng đặt thành một đơn riêng" : "Mỗi cửa hàng có một giỏ hàng và được đặt riêng")" />

@if (Loading) { <Skeleton Lines="5" /> }
else if (carts.Count == 0)
{
    <div class="card"><EmptyState Icon="🛒" Title="Giỏ hàng đang trống" Text="Hãy chọn vài món ngon nhé!"><a class="btn" href="/search">Tìm món ăn</a></EmptyState></div>
}
else
{
    @foreach (var cart in carts)
    {
        <div class="checkout-grid cart-store">
            <section class="card">
                <div class="section-title">
                    <h2>🏪 @cart.StoreName</h2>
                    <span class="flex">
                        <a class="link small" href="/stores/@cart.StoreId">+ Thêm món</a>
                        <button class="btn btn-ghost btn-sm danger-text" disabled="@Busy" @onclick="() => clearStoreId = cart.StoreId">🗑 Xóa giỏ</button>
                    </span>
                </div>
                @foreach (var l in cart.Lines)
                {
                    <div class="row-item">
                        <div class="avatar" style="width:52px;height:52px;font-size:26px">
                            @if (l.ImageUrl is not null) { <img src="@l.ImageUrl" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:11px" /> } else { @l.Emoji }
                        </div>
                        <div class="grow">
                            <strong>@l.Name</strong>
                            <span class="muted small">@Fmt.Vnd(l.UnitPrice)@(l.IsAvailable ? "" : " · Hết hàng")</span>
                        </div>
                        <div class="qty">
                            <button aria-label="Giảm" disabled="@Busy" @onclick="() => SetQty(l.ProductId, l.Quantity - 1)">−</button>
                            <span>@l.Quantity</span>
                            <button aria-label="Tăng" disabled="@(Busy || l.Quantity >= l.Stock)" @onclick="() => SetQty(l.ProductId, l.Quantity + 1)">+</button>
                        </div>
                        <b style="min-width:80px;text-align:right">@Fmt.Vnd(l.LineTotal)</b>
                        <button class="icon-btn" aria-label="Xóa @l.Name" disabled="@Busy" @onclick="() => SetQty(l.ProductId, 0)">✕</button>
                    </div>
                }
            </section>
            <aside class="card">
                <h2>Tóm tắt</h2>
                @foreach (var w in cart.Warnings) { <div class="alert alert-warning small">@w</div> }
                <div class="order-line"><span class="muted">Tạm tính (@cart.Count món)</span><strong>@Fmt.Vnd(cart.Subtotal)</strong></div>
                <div class="order-line"><span class="muted">Phí giao hàng (cơ bản)</span><strong>@Fmt.Vnd(cart.DeliveryFee)</strong></div>
                <div class="order-line total"><span>Tổng cộng</span><span class="primary-text">@Fmt.Vnd(cart.Total)</span></div>
                <p class="small muted">Phí giao được tính lại theo quãng đường khi bạn ghim điểm giao ở bước thanh toán.</p>
                <a class="btn btn-block" href="@(cart.CanCheckout ? $"/checkout/{cart.StoreId}" : null)" aria-disabled="@(!cart.CanCheckout)"
                   style="@(cart.CanCheckout ? "" : "opacity:.5;pointer-events:none")">Đặt đơn tại @cart.StoreName →</a>
            </aside>
        </div>
    }
}

<ConfirmDialog Open="clearStoreId is not null" OpenChanged="v => { if (!v) clearStoreId = null; }" Title="Xóa giỏ hàng này?"
               Message="Tất cả món của cửa hàng này sẽ bị xóa khỏi giỏ. Các giỏ của cửa hàng khác vẫn giữ nguyên."
               ConfirmText="Xóa giỏ" Danger="true" OnConfirm="Clear" />

@code {
    private IReadOnlyList<CartDto> carts = [];
    private int? clearStoreId;

    protected override async Task LoadAsync()
    {
        carts = await CartService.GetAllAsync();
        CartBadge.Set(carts.Sum(c => c.Count));
    }

    protected override bool ReloadOnRealtime(RealtimeMessage? m) => m is null;

    private Task SetQty(int productId, int qty) => RunAsync(() => CartService.SetQuantityAsync(productId, qty));

    private Task Clear(string _) => RunAsync(async () =>
    {
        var id = clearStoreId!.Value;
        clearStoreId = null;
        await CartService.ClearAsync(id);
    }, "Đã xóa giỏ hàng");
}
