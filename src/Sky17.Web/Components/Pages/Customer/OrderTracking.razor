@page "/orders/{Code}"
@attribute [Authorize(Roles = Roles.Customer)]
@inherits PortalPage
@inject ICustomerOrderService Orders

@if (Loading) { <Skeleton Cards="1" Lines="5" /> }
else if (order is null)
{
    <PageTitle>Không tìm thấy | Sky 17</PageTitle>
    <EmptyState Icon="📦" Title="Không tìm thấy đơn hàng"><a class="btn" href="/orders">Về danh sách đơn</a></EmptyState>
}
else
{
    <PageHeader Title="@($"Đơn {order.Code}")" Subtitle="@($"Đặt lúc {Fmt.Time(order.PlacedAtUtc)} tại {order.StoreName}")">
        <Actions>
            <OrderStatusBadge Status="order.Status" />
            @if (order.AllowedNextStatuses.Contains(OrderStatus.Cancelled))
            {
                <button class="btn btn-outline" @onclick="() => confirmCancel = true">Hủy đơn</button>
            }
        </Actions>
    </PageHeader>

    @if (Placed == 1 && order.Status == OrderStatus.Pending)
    {
        <div class="alert alert-success">🎉 Đặt hàng thành công! Cửa hàng sẽ sớm xác nhận đơn của bạn. Trang này tự cập nhật khi có thay đổi.</div>
    }
    @if (order.Status == OrderStatus.Cancelled) { <div class="alert alert-danger">Đơn đã hủy: @order.CancelReason</div> }
    @if (order.Status == OrderStatus.DeliveryFailed) { <div class="alert alert-danger">Giao hàng chưa thành công: @order.FailureReason. Bộ phận vận hành sẽ liên hệ bạn.</div> }

    @if (!OrderStateMachine.IsTerminal(order.Status) && order.Status != OrderStatus.DeliveryFailed)
    {
        <div class="card mb-2 searching" style="background:linear-gradient(110deg,#eaf2ff,#fff)">
            <div class="radar">@StatusEmoji</div>
            <div class="grow">
                <h2 style="margin:0 0 4px">@StatusHeadline</h2>
                <div class="muted">@StatusSub</div>
                @if (OrderStateMachine.IsKitchenOpen(order.Status))
                {
                    <span class="kitchen-badge mt-1 @(order.PreparationState == PreparationState.Ready ? "ready" : "")">@order.PreparationState.Text()</span>
                }
            </div>
        </div>
    }

    <div class="grid-2">
        <div class="stack">
            <section class="card">
                <h2>Hành trình đơn hàng</h2>
                @if (MapMarkers.ForOrder(order) is { Count: > 0 } markers)
                {
                    <div class="mb-2">
                        <MapView Markers="markers" Route="true" Height="260px" />
                        <p class="small muted mt-1">Quãng đường: @Fmt.Distance(order.DistanceMeters)@(order.DistanceSource == DistanceSource.Route ? " (theo đường bộ)" : "")</p>
                    </div>
                }
                <OrderTimeline History="order.History" Status="order.Status" />
            </section>
            <OrderSummaryCard Order="order" />
        </div>
        <div class="stack">
            <section class="card">
                <h2>Giao đến</h2>
                <p class="mb-0"><b>@order.RecipientName</b> · @order.RecipientPhone</p>
                <p class="muted">@order.DeliveryAddress</p>
                @if (!string.IsNullOrEmpty(order.DeliveryNote)) { <p class="small">📝 @order.DeliveryNote</p> }
            </section>
            <section class="card">
                <h2>Cửa hàng</h2>
                <p class="mb-0"><b>@order.StoreName</b></p>
                <p class="muted small mb-1">@order.PickupAddress</p>
                <a class="link" href="@Fmt.Tel(order.PickupPhone)">📞 @order.PickupPhone</a>
            </section>
            <section class="card">
                <h2>Tài xế</h2>
                @if (order.DriverName is not null && order.Status is not (OrderStatus.Cancelled or OrderStatus.Returned))
                {
                    <div class="row-item">
                        <div class="avatar">🛵</div>
                        <div class="grow"><strong>@order.DriverName</strong><span class="small muted">@order.DriverPlate</span></div>
                        @if (OrderStateMachine.IsInDelivery(order.Status)) { <a class="btn btn-soft btn-sm" href="@Fmt.Tel(order.DriverPhone)">📞 Gọi</a> }
                    </div>
                }
                else
                {
                    <p class="muted mb-0">@(order.IsSearchingDriver ? "🔎 Đang tìm tài xế gần quán nhất..." : "Chưa có tài xế.")</p>
                }
            </section>
        </div>
    </div>
}

<ConfirmDialog @bind-Open="confirmCancel" Title="Hủy đơn hàng?" Message="Bạn chỉ có thể hủy khi cửa hàng chưa xác nhận đơn."
               AskReason="true" Presets="cancelReasons" ConfirmText="Hủy đơn" Danger="true" Busy="Busy" OnConfirm="CancelAsync" />

@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery] public int? Placed { get; set; }
    private OrderDetailDto? order;
    private bool confirmCancel;
    private static readonly string[] cancelReasons = ["Đặt nhầm món", "Muốn đổi địa chỉ", "Thời gian chờ quá lâu"];

    protected override async Task LoadAsync() => order = await Orders.GetMyOrderAsync(Code);

    private Timer? refresh;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Live driver position: refresh every 15 s while a driver is on the way.
        refresh = new Timer(_ => InvokeAsync(async () =>
        {
            if (order is not null && OrderStateMachine.IsInDelivery(order.Status)) { await ReloadAsync(); StateHasChanged(); }
        }), null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    public override void Dispose()
    {
        refresh?.Dispose();
        base.Dispose();
    }

    private string StatusEmoji => order!.Status switch
    {
        OrderStatus.Pending => "🏪", OrderStatus.Confirmed => "🔎", OrderStatus.ArrivedAtStore => "🍱",
        OrderStatus.ArrivedAtCustomer => "📍", _ => "🛵",
    };

    private string StatusHeadline => order!.Status switch
    {
        OrderStatus.Pending => "Đang chờ quán xác nhận",
        OrderStatus.Confirmed => "Quán đang chuẩn bị · đang tìm tài xế",
        OrderStatus.Assigned => $"Tài xế {order.DriverName} đang đến quán",
        OrderStatus.ArrivedAtStore => $"Tài xế {order.DriverName} đang lấy món",
        OrderStatus.Delivering => $"Tài xế {order.DriverName} đang giao đến bạn",
        OrderStatus.ArrivedAtCustomer => "Tài xế đã đến! Vui lòng ra nhận hàng",
        _ => order.Status.Text(),
    };

    private string StatusSub => order!.Status switch
    {
        OrderStatus.Pending => $"{order.StoreName} sẽ xác nhận trong vài phút.",
        OrderStatus.Confirmed => "Hệ thống đang gửi đơn cho tài xế rảnh gần quán nhất.",
        OrderStatus.ArrivedAtCustomer => $"Chuẩn bị {Fmt.Vnd(order.GrandTotal)} tiền mặt để thanh toán.",
        _ => $"{order.DriverPlate} · cập nhật {Fmt.Ago(order.DriverLocationAtUtc ?? DateTime.UtcNow)}",
    };

    private Task CancelAsync(string reason) => RunAsync(async () =>
    {
        await Orders.CancelAsync(Code, reason);
        confirmCancel = false;
    }, "Đã hủy đơn hàng");
}
