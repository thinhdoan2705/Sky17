@page "/addresses"
@attribute [Authorize]
@inherits PortalPage
@inject IAddressService Addresses

<PageHeader Title="Sổ địa chỉ" Subtitle="Địa chỉ nhận hàng đã lưu">
    <Actions><button class="btn" @onclick="New">+ Thêm địa chỉ</button></Actions>
</PageHeader>

@if (Loading) { <Skeleton Lines="4" /> }
else if (list.Count == 0)
{
    <div class="card"><EmptyState Icon="📍" Title="Chưa có địa chỉ" Text="Thêm địa chỉ để đặt hàng nhanh hơn."><button class="btn" @onclick="New">+ Thêm địa chỉ</button></EmptyState></div>
}
else
{
    <div class="grid-half">
        @foreach (var a in list)
        {
            <div class="card">
                <div class="section-title">
                    <h2>@a.Label</h2>
                    @if (a.IsDefault) { <span class="status green">Mặc định</span> }
                </div>
                <p class="mb-0"><b>@a.RecipientName</b> · @a.PhoneNumber</p>
                <p class="muted">@a.FullText</p>
                <p class="small @(a.Latitude is null ? "danger-text" : "success-text")">@(a.Latitude is null ? "⚠ Chưa ghim vị trí trên bản đồ" : "📍 Đã ghim vị trí")</p>
                @if (!string.IsNullOrEmpty(a.Note)) { <p class="small">📝 @a.Note</p> }
                <div class="flex flex-wrap">
                    <button class="btn btn-soft btn-sm" @onclick="() => Edit(a.Id)">Sửa</button>
                    @if (!a.IsDefault) { <button class="btn btn-outline btn-sm" disabled="@Busy" @onclick="() => SetDefault(a.Id)">Đặt mặc định</button> }
                    <button class="btn btn-ghost btn-sm danger-text" @onclick="() => deleteId = a.Id">Xóa</button>
                </div>
            </div>
        }
    </div>
}

<Modal Open="editing is not null" OpenChanged="v => { if (!v) editing = null; }" Title="@(editing?.Id > 0 ? "Sửa địa chỉ" : "Thêm địa chỉ")">
    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="fields">
                <div class="field"><label>Nhãn</label><InputText @bind-Value="editing.Label" placeholder="Nhà, Công ty..." /><ValidationMessage For="() => editing.Label" /></div>
                <div class="field"><label>Người nhận</label><InputText @bind-Value="editing.RecipientName" /><ValidationMessage For="() => editing.RecipientName" /></div>
                <div class="field"><label>Số điện thoại</label><InputText type="tel" @bind-Value="editing.PhoneNumber" /><ValidationMessage For="() => editing.PhoneNumber" /></div>
                <div class="field"><label>Số nhà, đường</label><InputText @bind-Value="editing.Street" /><ValidationMessage For="() => editing.Street" /></div>
                <div class="field"><label>Phường/Xã</label><InputText @bind-Value="editing.Ward" /></div>
                <div class="field"><label>Quận/Huyện</label><InputText @bind-Value="editing.District" /></div>
                <div class="field"><label>Tỉnh/Thành phố</label><InputText @bind-Value="editing.City" /><ValidationMessage For="() => editing.City" /></div>
                <div class="field"><label>Ghi chú</label><InputText @bind-Value="editing.Note" /></div>
            </div>
            <LocationPicker Label="Ghim vị trí giao hàng (giúp tính phí chính xác)" Latitude="editing.Latitude" Longitude="editing.Longitude"
                            SearchText="@string.Join(", ", new[] { editing.Street, editing.Ward, editing.District, editing.City }.Where(s => !string.IsNullOrWhiteSpace(s)))"
                            OnChanged="SetLocation" Height="220px" />
            <label class="check"><InputCheckbox @bind-Value="editing.IsDefault" /> Đặt làm địa chỉ mặc định</label>
            <div class="form-actions"><button type="submit" class="btn" disabled="@Busy">Lưu địa chỉ</button></div>
        </EditForm>
    }
</Modal>

<ConfirmDialog Open="deleteId is not null" OpenChanged="v => { if (!v) deleteId = null; }" Title="Xóa địa chỉ?" Message="Địa chỉ này sẽ bị xóa khỏi sổ địa chỉ."
               ConfirmText="Xóa" Danger="true" OnConfirm="DeleteAsync" />

@code {
    private IReadOnlyList<AddressDto> list = [];
    private AddressInput? editing;
    private int? deleteId;

    protected override async Task LoadAsync() => list = await Addresses.GetMineAsync();
    protected override bool ReloadOnRealtime(RealtimeMessage? m) => m is null;

    private Task SetDefault(int id) => RunAsync(() => Addresses.SetDefaultAsync(id), "Đã đặt làm mặc định");
    private void New() => editing = new AddressInput { IsDefault = list.Count == 0 };
    private void SetLocation((double? Lat, double? Lng) p) { editing!.Latitude = p.Lat; editing.Longitude = p.Lng; }
    private async Task Edit(int id) => editing = await Addresses.GetForEditAsync(id);

    private Task SaveAsync() => RunAsync(async () => { await Addresses.SaveAsync(editing!); editing = null; }, "Đã lưu địa chỉ");

    private Task DeleteAsync(string _) => RunAsync(async () => { await Addresses.DeleteAsync(deleteId!.Value); deleteId = null; }, "Đã xóa địa chỉ");
}
