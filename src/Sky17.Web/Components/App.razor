<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1769e0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/leaflet/leaflet.css"]" />
    <link rel="stylesheet" href="@Assets["css/sky17.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/ios.css"]" />
    <link rel="stylesheet" href="@Assets["Sky17.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        Đã có lỗi xảy ra. <a href="." class="link">Tải lại</a>
        <span class="dismiss">✕</span>
    </div>
    <script src="@Assets["lib/signalr/signalr.min.js"]"></script>
    <script src="@Assets["lib/leaflet/leaflet.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Identity pages (/Account/*) are static SSR so they can set cookies; everything else is Interactive Server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
