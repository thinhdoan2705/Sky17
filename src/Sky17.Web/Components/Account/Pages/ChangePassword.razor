@page "/Account/Manage/ChangePassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Đổi mật khẩu | Sky 17</PageTitle>

<h1>Đổi mật khẩu</h1>
<StatusMessage Message="@message" />
<EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="old">Mật khẩu hiện tại</label>
        <InputText id="old" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" />
        <ValidationMessage For="() => Input.OldPassword" />
    </div>
    <div class="field">
        <label for="new">Mật khẩu mới</label>
        <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.NewPassword" />
    </div>
    <div class="field">
        <label for="confirm">Nhập lại mật khẩu mới</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="btn btn-block">Cập nhật mật khẩu</button>
</EditForm>
<div class="auth-links"><a class="link" href="/profile">← Về hồ sơ</a></div>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) RedirectManager.RedirectTo("Account/Login");
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null) return;
        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            message = result.Errors.Any(e => e.Code == "PasswordMismatch")
                ? "Error: Mật khẩu hiện tại không đúng."
                : "Error: Mật khẩu mới chưa đạt yêu cầu (tối thiểu 8 ký tự, có chữ thường và chữ số).";
            return;
        }
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Đã đổi mật khẩu thành công.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Nhập mật khẩu hiện tại")] public string OldPassword { get; set; } = "";
        [Required(ErrorMessage = "Nhập mật khẩu mới"), StringLength(100, MinimumLength = 8, ErrorMessage = "Mật khẩu tối thiểu 8 ký tự")]
        public string NewPassword { get; set; } = "";
        [Compare("NewPassword", ErrorMessage = "Mật khẩu xác nhận không khớp")] public string ConfirmPassword { get; set; } = "";
    }
}
