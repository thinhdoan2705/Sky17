@inject NavigationManager Nav
@inject IProfileService Profiles

<AuthorizeView>
    <Authorized>
        <button class="user-btn" aria-label="Tài khoản" @onclick="() => open = !open">
            <div class="user">@Fmt.Initials(DisplayName ?? context.User.Identity?.Name)</div>
        </button>
        @if (open)
        {
            <div class="menu-overlay" @onclick="() => open = false"></div>
            <div class="dropdown" style="width:270px">
                <div class="dropdown-head">
                    <div>
                        <b>@(DisplayName ?? context.User.Identity?.Name)</b>
                        <div class="small muted">@string.Join(" · ", Roles.All.Where(context.User.IsInRole).Select(Labels.RoleText))</div>
                    </div>
                </div>
                @if (context.User.IsInRole(Roles.Admin)) { <a class="dd-item" href="/admin">🛡️ Trang quản trị</a> }
                @if (context.User.IsInRole(Roles.Seller)) { <a class="dd-item" href="/seller">🏪 Quản lý cửa hàng</a> }
                @if (context.User.IsInRole(Roles.Driver)) { <a class="dd-item" href="/driver">🛵 Ứng dụng tài xế</a> }
                @if (context.User.IsInRole(Roles.Customer))
                {
                    <a class="dd-item" href="/orders">📦 Đơn hàng của tôi</a>
                    <a class="dd-item" href="/addresses">📍 Sổ địa chỉ</a>
                }
                <a class="dd-item" href="/profile">👤 Hồ sơ cá nhân</a>
                <a class="dd-item" href="/Account/Manage/ChangePassword" data-enhance-nav="false">🔑 Đổi mật khẩu</a>
                <form action="/Account/Logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@LogoutReturnUrl" />
                    <button type="submit" class="dd-item danger-text">↩ Đăng xuất</button>
                </form>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-sm" href="@LoginUrl" data-enhance-nav="false">Đăng nhập</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string? Name { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool open;
    private string? loadedName;

    /// <summary>Full name (customers log in with a phone number, which is not a friendly display name).</summary>
    private string? DisplayName => Name ?? loadedName;

    protected override async Task OnInitializedAsync()
    {
        if (Name is not null || AuthState is null) return;
        if ((await AuthState).User.Identity?.IsAuthenticated != true) return;
        try { loadedName = (await Profiles.GetMineAsync()).FullName; }
        catch (ForbiddenException) { }
    }

    /// <summary>Partners return to their portal's login page after signing out; customers stay on the home page.</summary>
    private string LogoutReturnUrl
    {
        get
        {
            var portal = Sky17.Web.Components.Account.LoginPortals.ForPath("/" + Nav.ToBaseRelativePath(Nav.Uri));
            return portal == Sky17.Web.Components.Account.LoginPortals.Customer ? "/" : portal.Path;
        }
    }

    private string LoginUrl
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            return Sky17.Web.Components.Account.LoginPortals.LoginUrlFor(path);
        }
    }
}
