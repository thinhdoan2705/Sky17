<div aria-busy="true" aria-label="Đang tải">
    @if (Cards > 0)
    {
        <div class="kpis">
            @for (var i = 0; i < Cards; i++) { <div class="skeleton skeleton-card"></div> }
        </div>
    }
    @for (var i = 0; i < Lines; i++)
    {
        <div class="skeleton skeleton-line" style="width:@(100 - (i % 3) * 15)%"></div>
    }
</div>

@code {
    [Parameter] public int Lines { get; set; } = 3;
    [Parameter] public int Cards { get; set; }
}
