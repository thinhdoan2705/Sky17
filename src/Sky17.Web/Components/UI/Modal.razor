@* Dialog; renders as a bottom sheet on small screens (see app.css). *@
@if (Open)
{
    <div class="dialog-backdrop open" @onclick="Close" role="presentation">
        <div class="dialog @(Wide ? "dialog-wide" : "")" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h2>@Title</h2>
                <button class="close" aria-label="Đóng" @onclick="Close"><Icon Name="xmark" Size="14" Stroke="2.6" /></button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);
}
