@if (Open)
{
    <div class="drawer-backdrop" @onclick="Close">
        <aside class="drawer" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h2>@Title</h2>
                <button class="close" aria-label="Đóng" @onclick="Close">✕</button>
            </div>
            @ChildContent
        </aside>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);
}
