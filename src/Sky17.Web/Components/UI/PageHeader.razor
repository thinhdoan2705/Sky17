<PageTitle>@Title | Sky 17</PageTitle>
<div class="page-head">
    <div>
        <h1>@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle)) { <div class="muted">@Subtitle</div> }
    </div>
    @if (Actions is not null) { <div class="flex flex-wrap">@Actions</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
