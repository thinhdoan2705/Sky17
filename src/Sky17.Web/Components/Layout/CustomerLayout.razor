@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart
@inject ICartService CartService
@inject NavigationManager Nav

<div class="customer-page">
    <header class="shop-header">
        <a class="logo" href="/" style="padding:0"><span class="logo-mark"><Icon Name="bolt" Size="20" Stroke="2.2" /></span>SHIP <em>SKY 17</em></a>
        <form class="search-field shop-search-form" @onsubmit="Search" role="search">
            <Icon Name="search" Size="18" />
            <input type="search" placeholder="Tìm đồ ăn, thức uống, cửa hàng" @bind="query" aria-label="Tìm kiếm" />
        </form>
        <nav class="shop-nav">
            <NavLink href="/stores">Cửa hàng</NavLink>
            <AuthorizeView Roles="Customer">
                <NavLink href="/orders">Đơn hàng</NavLink>
                <NavLink href="/cart">Giỏ hàng@(Cart.Count > 0 ? $" ({Cart.Count})" : "")</NavLink>
            </AuthorizeView>
            <NotificationBell />
            <UserMenu />
        </nav>
        <div class="mobile-actions">
            <NotificationBell />
            <UserMenu />
        </div>
    </header>
    <main class="shop-container">
        @Body
    </main>
    <AuthorizeView Roles="Customer">
        @if (Cart.Count > 0 && IsShoppingPage)
        {
            <a class="shop-floating-cart" href="/cart"><Icon Name="cart" Size="20" /> Xem giỏ hàng · @Cart.Count món</a>
        }
    </AuthorizeView>
    <nav class="mobile-tabs" aria-label="Điều hướng">
        <NavLink href="/" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="house" /><span>Trang chủ</span></NavLink>
        <NavLink href="/search" ActiveClass="active"><Icon Name="search" /><span>Tìm món</span></NavLink>
        <NavLink href="/orders" ActiveClass="active"><Icon Name="receipt" /><span>Đơn hàng</span></NavLink>
        <NavLink href="/cart" ActiveClass="active" class="tab-cart"><Icon Name="cart" />@if (Cart.Count > 0) { <b class="tab-badge">@Cart.Count</b> }<span>Giỏ hàng</span></NavLink>
        <NavLink href="/profile" ActiveClass="active"><Icon Name="person-circle" /><span>Tài khoản</span></NavLink>
    </nav>
</div>
<ToastHost />
<RealtimeListener />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string query = "";

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += OnCartChanged;
        if (AuthState is not null && (await AuthState).User.IsInRole(Roles.Customer))
        {
            try { Cart.Set(await CartService.CountAsync()); } catch (ForbiddenException) { }
        }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Floating cart only where the customer is picking dishes; elsewhere the tab bar badge shows the count.</summary>
    private bool IsShoppingPage
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
            return path == "/" || path.StartsWith("/search") || path.StartsWith("/stores") || path.StartsWith("/products");
        }
    }

    private void Search()
    {
        Nav.NavigateTo("/search?q=" + Uri.EscapeDataString(query.Trim()));
    }

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
